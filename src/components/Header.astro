---
import site from '../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/url.ts';
const path = Astro.url.pathname;
const links = [
  { href: '', label: 'Tool' },
  { href: 'about/', label: 'About' },
  { href: 'contact/', label: 'Contact' },
];
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href={url()} class="flex items-center gap-2.5 font-bold tracking-tight text-ink no-underline">
      <img src={url('favicon.svg')} alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span class="whitespace-nowrap">{site.shortName}</span>
    </a>
    <div class="flex items-center gap-1">
      <a href="https://bingemind.com/tools/" class="whitespace-nowrap rounded-full px-3 py-3 text-sm font-medium text-brand-ink no-underline hover:underline max-[420px]:px-2">More free tools</a>
      <nav aria-label="Main" class="flex items-center">
        {links.map((l) => (
          <a href={url(l.href)} aria-current={path === url(l.href) ? 'page' : undefined}
            class:list={['rounded-full px-3 py-2 text-sm font-medium text-muted no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-brand-soft max-[420px]:px-2', l.href === '' && 'max-[480px]:hidden']}>{l.label}</a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

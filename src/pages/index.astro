---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import PageLinks from '../components/PageLinks.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    featureList: ['Bar sizes #3 to #18 (ASTM A615)', 'Metric bar sizes and round diameters', 'Weight per foot and per bar on every line', 'Bars to order for 20, 40 and 60 ft stock', 'Material cost from a price per lb or ton', 'Totals in lb, kg, short tons and metric tons', 'Copy, print, CSV download and share link'],
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', worksFor: { '@type': 'Organization', name: 'Oqu AI' }, url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to calculate the weight of rebar',
    totalTime: 'PT1M',
    step: [
      'Pick the bar size.',
      'Enter the length of one bar in feet and inches.',
      'Enter how many bars have that length.',
      'Add a line for each other size or length.',
      'Add a waste percentage for laps and cut-offs.',
    ].map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <p class="mb-3 inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">{site.tagline}</p>
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight [text-wrap:balance] sm:text-5xl">
      Rebar weight calculator
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">Add one line per bar size and length. The totals update as you type, in pounds, kilograms and tons.</p>
    <div class="mt-8"><Tool /></div>
    <AdSlot />
  </section>
  <Article />
  <PageLinks />
  <Faq />
</Base>
